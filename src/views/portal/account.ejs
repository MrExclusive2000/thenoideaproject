<%- include('../partials/portal-top', { title, subtitle }) %>

<div class="dl-item">
  <div class="name"><%= c.display_name || c.username %></div>
  <div class="meta">Username: <%= c.username %></div>
  <div class="desc">
    <% if (!c.expires_at) { %>Your access does not expire.
    <% } else if (c.expires_at < nowTs) { %>Your access expired on <%= formatDate(c.expires_at).slice(0, 10) %>.
    <% } else { %>Access valid until <strong><%= formatDate(c.expires_at).slice(0, 10) %></strong> (<%= Math.ceil((c.expires_at - nowTs) / 86400) %> days left).
    <% } %>
  </div>
</div>

<div class="dl-item">
  <div class="name">Connect Telegram</div>
  <% if (c.telegram_user_id) { %>
    <div class="desc">✅ Your Telegram is connected. Message the bot privately for /myaccount, /download, /guides and support — and you'll get a reminder before your access expires.</div>
  <% } else { %>
    <div class="desc">Connect your Telegram to get your files, guides and expiry reminders straight from the bot.</div>
    <% if (linkCode) { %>
      <div class="desc">Send this to the bot in a <strong>private message</strong> (valid 48h):<br>
        <code style="font-size:18px">/link <%= linkCode.code %></code></div>
    <% } %>
    <form method="post" action="/portal/account/link-code">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button type="submit" class="dl-btn" style="border:0;cursor:pointer"><%= linkCode ? 'Get a new code' : 'Get my link code' %></button>
    </form>
  <% } %>
</div>

<form method="post" action="/logout" style="text-align:center;margin-top:26px">
  <input type="hidden" name="_csrf" value="<%= csrf %>">
  <button type="submit" class="btn-ghost">Log out</button>
</form>

<%- include('../partials/portal-bottom') %>
