<%- include('../partials/admin-top', { title }) %>

<h1>Support tickets</h1>
<p class="sub">Conversations started from Telegram DMs. Your replies are delivered back through the bot.</p>

<div class="toolbar">
  <a class="btn <%= show === 'open' ? '' : 'btn-ghost' %> btn-sm" href="/admin/tickets">Open &amp; pending</a>
  <a class="btn <%= show === 'closed' ? '' : 'btn-ghost' %> btn-sm" href="/admin/tickets?show=closed">Closed</a>
</div>

<div class="card">
  <table class="list">
    <tr><th>Ticket</th><th>From</th><th>Last message</th><th>Status</th><th>Updated</th></tr>
    <% for (const t of tickets) { %>
    <tr>
      <td><a href="/admin/tickets/<%= t.id %>"><strong>#<%= t.id %> <%= t.subject || '(no subject)' %></strong></a>
        <div class="hint"><%= t.message_count %> message<%= t.message_count === 1 ? '' : 's' %></div></td>
      <td><%= t.customer_name || t.tg_username || `tg:${t.telegram_user_id}` %></td>
      <td class="hint" style="max-width:320px"><%= (t.last_message || '').slice(0, 100) %></td>
      <td><span class="badge <%= t.status === 'open' ? 'badge-warn' : (t.status === 'pending' ? 'badge-ok' : 'badge-dim') %>"><%= t.status %></span></td>
      <td class="hint"><%= formatDate(t.updated_at) %></td>
    </tr>
    <% } %>
    <% if (!tickets.length) { %><tr><td colspan="5" class="hint">No <%= show %> tickets.</td></tr><% } %>
  </table>
</div>

<%- include('../partials/admin-bottom') %>
