<%- include('../partials/admin-top', { title }) %>

<h1>Ticket #<%= ticket.id %>
  <span class="badge <%= ticket.status === 'open' ? 'badge-warn' : (ticket.status === 'pending' ? 'badge-ok' : 'badge-dim') %>"><%= ticket.status %></span>
</h1>
<p class="sub">
  From <strong><%= ticket.customer_name || ticket.tg_username || `Telegram ${ticket.telegram_user_id}` %></strong>
  · opened <%= formatDate(ticket.created_at) %> · <a href="/admin/tickets">← all tickets</a>
</p>

<% const stranded = messages.filter((m) => m.sender.startsWith('admin') && m.delivered === 0); %>
<% if (stranded.length) { %>
<div class="flash flash-err">⚠️ <%= stranded.length %> repl<%= stranded.length > 1 ? 'ies have' : 'y has' %> NOT reached the customer yet. It delivers automatically the moment they message the bot — or press Resend below.</div>
<% } %>

<div class="card">
  <% for (const m of messages) { %>
  <div style="margin-bottom:14px">
    <div class="hint">
      <strong style="color:<%= m.sender.startsWith('admin') ? 'var(--accent)' : 'var(--text)' %>">
        <%= m.sender.startsWith('admin') ? m.sender.replace('admin:', '') + ' (admin)' : 'customer' %>
      </strong> · <%= formatDate(m.ts) %>
      <% if (m.sender.startsWith('admin') && m.delivered === 1) { %><span class="badge badge-ok">delivered ✓</span><% } %>
      <% if (m.sender.startsWith('admin') && m.delivered === 0) { %><span class="badge badge-bad">not delivered</span><% } %>
    </div>
    <div style="white-space:pre-wrap"><%= m.body %></div>
    <% if (m.sender.startsWith('admin') && m.delivered === 0) { %>
    <form method="post" action="/admin/tickets/<%= ticket.id %>/resend/<%= m.id %>" style="margin-top:4px">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn-ghost btn-sm">Resend</button>
    </form>
    <% } %>
  </div>
  <% } %>
</div>

<div class="row">
  <div class="card">
    <h2>Reply</h2>
    <% if (!botOnline) { %><div class="flash flash-err">Bot offline — the reply will be saved but not delivered.</div><% } %>
    <% if (!ticket.telegram_user_id) { %><div class="flash flash-err">This ticket has no Telegram user attached — replies can't be delivered.</div><% } %>
    <form method="post" action="/admin/tickets/<%= ticket.id %>/reply">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <textarea name="body" rows="4" maxlength="3500" required placeholder="Your reply — sent to the customer as a Telegram DM."></textarea>
      <p><button type="submit">Send reply</button></p>
    </form>
  </div>
  <div class="card">
    <h2>Status</h2>
    <form method="post" action="/admin/tickets/<%= ticket.id %>/status" class="toolbar">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <button class="btn-ghost btn-sm" name="status" value="open">Open</button>
      <button class="btn-ghost btn-sm" name="status" value="pending">Pending</button>
      <button class="btn-sm" name="status" value="closed">Close ticket</button>
    </form>
    <p class="hint">Closing notifies the customer (when linked). They can always open a new ticket by messaging the bot.</p>
  </div>
</div>

<%- include('../partials/admin-bottom') %>
