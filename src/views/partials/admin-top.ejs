<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= title %> · <%= appName %></title>
  <link rel="stylesheet" href="/assets/app.css">
  <style>:root { --accent: <%= accentColor %>; }</style>
</head>
<body class="admin">
<% if (httpWarning) { %>
  <div class="http-warn">⚠ You are using this panel over plain HTTP — traffic (including passwords) is not encrypted. Put it behind HTTPS (reverse proxy) if it is reachable from the internet.</div>
<% } %>
<%#
  The menu toggle is a checkbox rather than a script: the panel is often open
  on a phone, the Content-Security-Policy here only allows nonced scripts, and
  a menu that needs JavaScript to open is a menu that can fail to open. On a
  wide screen the CSS ignores it entirely and the sidebar is simply there.
-%>
<input type="checkbox" id="navtoggle" class="nav-toggle" aria-label="Menu">
<div class="admin-wrap">
  <nav class="sidebar">
   <div class="sidebar-inner">
    <div class="brand">
      <% if (hasLogo) { %><img src="/admin/branding/logo" alt=""><% } else { %><span class="dot"></span><% } %>
      <span><%= appName %></span>
    </div>

    <% if (admin && admin.must_change_password) { %>
    <div class="group">Locked</div>
    <a class="nav active" href="/admin/password">Set new password</a>
    <div class="foot">The menu unlocks after you choose a new password.</div>
    <% } else { %>
    <% for (const g of nav) { %>
      <div class="group"><%= g.group %></div>
      <% for (const item of g.items) { %>
      <a class="nav <%= item.current ? 'active' : '' %>" href="<%= item.href %>">
        <span class="nav-label"><%= item.label %></span>
        <% if (item.badge) { %><span class="nav-count"><%= item.badge %></span><% } %>
      </a>
      <% } %>
    <% } %>
    <div class="foot">
      <div title="Running build (commit · date)">build <%= buildId %></div>
    </div>
    <% } %>
   </div>
  </nav>
  <%# Tapping the page closes the slide-out menu. Invisible on a wide screen. -%>
  <label for="navtoggle" class="nav-scrim" aria-hidden="true"></label>

  <main class="main">
    <div class="topbar">
      <label for="navtoggle" class="nav-burger" title="Menu">☰</label>
      <span class="topbar-where"><%= section || title %></span>
      <span class="spacer"></span>
      <% if (botState.status === 'online') { %>
        <a class="pill pill-ok" href="/admin" title="Bot connected to Telegram">● <%= botState.username ? '@' + botState.username : 'bot online' %></a>
      <% } else if (botState.status === 'disabled') { %>
        <a class="pill pill-dim" href="/admin" title="No bot token set">● bot off</a>
      <% } else { %>
        <a class="pill pill-bad" href="/admin" title="<%= botState.lastError || botState.status %>">● bot <%= botState.status %></a>
      <% } %>
      <span class="topbar-who"><%= admin ? admin.username : '' %></span>
      <form method="post" action="/admin/logout">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <button class="btn-ghost btn-sm">Log out</button>
      </form>
    </div>
    <% if (flash) { %><div class="flash flash-<%= flash.type %>"><%= flash.message %></div><% } %>
