# Copy to .env for local/docker-compose runs. On Pelican these come from the egg variables.

# Telegram bot token from @BotFather (also disable Group Privacy there)
TELEGRAM_BOT_TOKEN=

# Your Llama endpoint (OpenAI-compatible). Local Ollama example below; no key needed for Ollama.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=llama3.1
AI_API_KEY=

# First admin account (created on first boot; password change forced at first login).
# Leave ADMIN_PASSWORD empty to auto-generate one (printed once in the console).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Address customers use to reach the portal (used in links the bot sends)
PUBLIC_URL=

# Web server
PORT=8080
MAX_UPLOAD_MB=512

# Set to 1 when running behind an HTTPS reverse proxy
TRUST_PROXY=0
FORCE_SECURE_COOKIE=0
